datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  USER
}

enum OtpType {
  REGISTER_VERIFY
  RESET_PASSWORD
}

enum SimulationRequestStatus {
  PENDING
  UNDER_REVIEW
  PLANNED
  IN_DEVELOPMENT
  COMPLETED
  REJECTED
}

model User {
  id                     String                  @id @default(uuid())
  username               String                  @unique
  email                  String?                 @unique
  passwordHash           String?                 @map("password_hash")
  googleId               String?                 @unique @map("google_id")
  isEmailVerified        Boolean                 @default(false) @map("is_email_verified")
  avatarUrl              String?                 @map("avatar_url")
  role                   Role                    @default(USER)
  isDeleted              Boolean                 @default(false) @map("is_deleted")
  deletedAt              DateTime?               @map("deleted_at")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  simulationRuns         SimulationRun[]
  comments               Comment[]
  otpTokens              OtpToken[]
  simulationRequests     SimulationRequest[]
  simulationRequestVotes SimulationRequestVote[]

  @@map("users")
}

model OtpToken {
  id        String    @id @default(uuid())
  email     String
  code      String    @db.VarChar(6)
  type      OtpType
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  userId    String?   @map("user_id")
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email, type])
  @@index([code])
  @@map("otp_tokens")
}

model SimulationRun {
  id             String   @id @default(uuid())
  simulationSlug String   @map("simulation_slug") @db.VarChar(64)
  parameters     Json
  results        Json
  trialsCount    Int      @default(1) @map("trials_count")
  durationMs     Int?     @map("duration_ms")
  clientSession  String?  @map("client_session") @db.VarChar(64)
  userId         String?  @map("user_id")
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([simulationSlug])
  @@index([clientSession])
  @@index([createdAt(sort: Desc)])
  @@map("simulation_runs")
}

model Comment {
  id             String    @id @default(uuid())
  content        String    @db.VarChar(2000)
  simulationSlug String    @map("simulation_slug") @db.VarChar(64)
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId       String?   @map("parent_id")
  parent         Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies        Comment[] @relation("CommentReplies")
  isDeleted      Boolean   @default(false) @map("is_deleted")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([simulationSlug])
  @@index([parentId])
  @@index([createdAt(sort: Desc)])
  @@map("comments")
}

model SimulationRequest {
  id               String                  @id @default(uuid())
  title            String                  @db.VarChar(150)
  category         String                  @db.VarChar(64)
  description      String                  @db.VarChar(3000)
  whyInteresting   String?                 @map("why_interesting") @db.VarChar(2000)
  proposedControls String?                 @map("proposed_controls") @db.VarChar(2000)
  referenceUrl     String?                 @map("reference_url") @db.VarChar(500)
  status           SimulationRequestStatus @default(PENDING)
  voteCount        Int                     @default(0) @map("vote_count")

  userId           String?                 @map("user_id")
  user             User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  guestName        String?                 @map("guest_name") @db.VarChar(100)
  guestEmail       String?                 @map("guest_email") @db.VarChar(150)

  adminNotes       String?                 @map("admin_notes") @db.VarChar(2000)
  targetSlug       String?                 @map("target_slug") @db.VarChar(64)

  isDeleted        Boolean                 @default(false) @map("is_deleted")
  deletedAt        DateTime?               @map("deleted_at")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  votes            SimulationRequestVote[]

  @@index([status])
  @@index([category])
  @@index([voteCount(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("simulation_requests")
}

model SimulationRequestVote {
  id            String            @id @default(uuid())
  requestId     String            @map("request_id")
  request       SimulationRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId        String?           @map("user_id")
  user          User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientSession String?           @map("client_session") @db.VarChar(64)
  createdAt     DateTime          @default(now()) @map("created_at")

  @@unique([requestId, userId])
  @@unique([requestId, clientSession])
  @@index([requestId])
  @@map("simulation_request_votes")
}
