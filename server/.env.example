# Wonderlab — Server Environment Template
NODE_ENV=development
SERVER_PORT=4101
CORS_ORIGINS=http://localhost:4100
JWT_SECRET=wonderlab_dev_jwt_secret_change_in_production_32chars_min
JWT_EXPIRES_IN=7d
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@wonderlab.local
SEED_ADMIN_PASSWORD=Admin@Wonderlab2026!

# Database Connection
DATABASE_URL=postgresql://wonderlab:wonderlab_dev_pass@127.0.0.1:5432/wonderlab?schema=public

# Central Gateway Integration
GATEWAY_URL=http://localhost:5101/api/v1
GATEWAY_SECRET_KEY=dev_gateway_secret_key_change_in_production_32chars
