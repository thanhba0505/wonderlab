# ==============================================================================
# Wonderlab — Environment Configuration Template
# Copy this file to .env or .env.local for local development.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Client (Next.js)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Wonderlab
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# ------------------------------------------------------------------------------
# Server (NestJS)
# ------------------------------------------------------------------------------
NODE_ENV=development
SERVER_PORT=3001
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------------------
# PostgreSQL (Docker Compose Local Development Only)
# ------------------------------------------------------------------------------
POSTGRES_DB=wonderlab
POSTGRES_USER=wonderlab
POSTGRES_PASSWORD=replace_with_local_secret
POSTGRES_PORT=5433
POSTGRES_HOST=127.0.0.1
