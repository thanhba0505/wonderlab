# ==============================================================================
# Wonderlab — Environment Configuration Template
# Copy this file to .env or .env.local for local development.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Client (Next.js) — Default Port: 4100
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Wonderlab
NEXT_PUBLIC_APP_URL=http://localhost:4100
NEXT_PUBLIC_API_BASE_URL=http://localhost:4101/api/v1

# ------------------------------------------------------------------------------
# Server (NestJS) — Default Port: 4101
# ------------------------------------------------------------------------------
NODE_ENV=development
SERVER_PORT=4101
CORS_ORIGINS=http://localhost:4100
JWT_SECRET=wonderlab_dev_jwt_secret_change_in_production_32chars_min
JWT_EXPIRES_IN=7d
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@wonderlab.local
SEED_ADMIN_PASSWORD=Admin@Wonderlab2026!

# ------------------------------------------------------------------------------
# Database & Prisma Connection
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://wonderlab:wonderlab_dev_pass@127.0.0.1:5434/wonderlab?schema=public

# ------------------------------------------------------------------------------
# PostgreSQL (Docker Compose Local Development Only) — Default Port: 5434
# ------------------------------------------------------------------------------
POSTGRES_DB=wonderlab
POSTGRES_USER=wonderlab
POSTGRES_PASSWORD=replace_with_local_secret
POSTGRES_PORT=5434
POSTGRES_HOST=127.0.0.1
