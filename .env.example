# ==============================================================================
# Wonderlab — Environment Configuration Template
# Copy this file to .env or .env.local for local development.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Client (Next.js) — Default Port: 4100 (Worktrees: 4200, 4300, 4400, 4500, 4600)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=Wonderlab
NEXT_PUBLIC_APP_URL=http://localhost:4100
NEXT_PUBLIC_API_BASE_URL=http://localhost:4101/api/v1
NEXT_PUBLIC_GATEWAY_CLIENT_URL=http://localhost:5100

# ------------------------------------------------------------------------------
# Server (NestJS) — Default Port: 4101 (Worktrees: 4201, 4301, 4401, 4501, 4601)
# ------------------------------------------------------------------------------
NODE_ENV=development
SERVER_PORT=4101
CORS_ORIGINS=http://localhost:4100
JWT_SECRET=wonderlab_dev_jwt_secret_change_in_production_32chars_min
JWT_EXPIRES_IN=7d
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@wonderlab.local
SEED_ADMIN_PASSWORD=Admin@Wonderlab2026!

# ------------------------------------------------------------------------------
# Central Gateway Integration (SSO IAM Hub & Notification Broker)
# ------------------------------------------------------------------------------
GATEWAY_URL=http://localhost:5101/api/v1
GATEWAY_SECRET_KEY=dev_gateway_secret_key_change_in_production_32chars

# ------------------------------------------------------------------------------
# Database & Prisma Connection — Shared PostgreSQL Container on Port 5432
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://wonderlab:postgres@127.0.0.1:5432/wonderlab?schema=public

# ------------------------------------------------------------------------------
# PostgreSQL (Docker Compose Local Development Only) — Default Port: 5432
# ------------------------------------------------------------------------------
POSTGRES_DB=wonderlab
POSTGRES_USER=wonderlab
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_HOST=127.0.0.1
